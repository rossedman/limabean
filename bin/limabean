#!/usr/bin/env bash
# limabean: create and manage dev VMs from the Lima templates in this repo.
# Thin wrapper around limactl; see README.md. Works with macOS's bash 3.2.
# Paths like "~/code" are kept unexpanded on purpose: Lima expands them.
# shellcheck disable=SC2088
set -euo pipefail

# --- locations ---------------------------------------------------------------

# Resolve this script through symlinks, so `ln -s …/bin/limabean ~/.local/bin`
# still finds the templates next to it.
self=$0
while [ -L "$self" ]; do
  link=$(readlink "$self")
  case $link in
    /*) self=$link ;;
    *) self=$(dirname "$self")/$link ;;
  esac
done
ROOT=$(cd "$(dirname "$self")/.." && pwd)
TEMPLATES=$ROOT/templates

CONFIG=${LIMABEAN_CONFIG:-$HOME/.config/limabean/config}
STATE=$HOME/.local/state/limabean   # remembers which environment each VM uses
CLAUDE_SETTINGS=${LIMABEAN_CLAUDE_SETTINGS:-$HOME/.claude/settings.json}

# Defaults; the config file overrides them.
GIT_CONFIG_DIR="~/.config/git"
CODE_DIR="~/code"
CPUS=""
MEMORY=""
CLAUDE_DESKTOP="yes"   # register each VM as an SSH connection in Claude Desktop
# shellcheck disable=SC1090
[ -f "$CONFIG" ] && . "$CONFIG"

# --- output ------------------------------------------------------------------

if [ -t 1 ]; then
  bold=$'\e[1m' red=$'\e[31m' green=$'\e[32m' yellow=$'\e[33m' reset=$'\e[0m'
else
  bold='' red='' green='' yellow='' reset=''
fi
ok()   { printf '  %s✓%s %s\n' "$green" "$reset" "$*"; }
bad()  { printf '  %s✗%s %s\n' "$red" "$reset" "$*"; }
warn() { printf '  %s!%s %s\n' "$yellow" "$reset" "$*"; }
hint() { printf '      %s\n' "$@"; }
die()  { printf '%slimabean:%s %s\n' "$red" "$reset" "$*" >&2; exit 1; }
info() { printf '%s==>%s %s\n' "$bold" "$reset" "$*"; }

# Expand a leading ~ (config values are stored unexpanded).
expand() { case $1 in "~") echo "$HOME" ;; "~/"*) echo "$HOME/${1#\~/}" ;; *) echo "$1" ;; esac; }

# --- helpers -----------------------------------------------------------------

# Not grep -q: it exits early, limactl gets SIGPIPE, and pipefail fails the check.
exists()  { limactl list --format '{{.Name}}' 2>/dev/null | grep -x "$1" >/dev/null; }
status()  { limactl list "$1" --format '{{.Status}}' 2>/dev/null; }
need_vm() { exists "$1" || die "no VM named '$1' (see: limabean ls)"; }

ensure_running() {
  if [ "$(status "$1")" != Running ]; then
    info "Starting $1"
    limactl start --tty=false "$1"
  fi
}

envs() {
  local f
  for f in "$TEMPLATES"/*.yaml; do
    f=$(basename "$f" .yaml)
    case $f in layer-*) ;; *) echo "$f" ;; esac
  done
}

# create <name> <env>: limactl start with the template and the user's config.
create() {
  local name=$1 env=$2 template=$TEMPLATES/$2.yaml
  [ -f "$template" ] || die "unknown environment '$env'. Available: $(envs | tr '\n' ' ')"
  local args=(--name="$name" --tty=false
    --param "gitConfigDir=$GIT_CONFIG_DIR"
    --param "codeDir=$CODE_DIR")
  [ -n "$CPUS" ] && args+=(--cpus "$CPUS")
  [ -n "$MEMORY" ] && args+=(--memory "$MEMORY")
  info "Creating $name from $env (first boot takes a minute or two)"
  limactl start "${args[@]}" "$template"
  mkdir -p "$STATE"
  echo "$env" > "$STATE/$name.env"
}

# --- Claude Desktop SSH connections -------------------------------------------
# Each VM is an entry in "sshConfigs" in ~/.claude/settings.json, which Claude
# Desktop lists under SSH in the environment dropdown. limabean only touches
# entries whose id starts with "limabean-".

# claude_edit <jq args…>: apply a jq filter to the settings file in place.
claude_edit() {
  [ "$CLAUDE_DESKTOP" = yes ] || return 0
  if ! command -v jq >/dev/null; then
    warn "jq not found, so Claude Desktop wasn't updated (brew install jq, then: limabean claude sync)"
    return 0
  fi
  mkdir -p "$(dirname "$CLAUDE_SETTINGS")"
  [ -s "$CLAUDE_SETTINGS" ] || echo '{}' > "$CLAUDE_SETTINGS"
  local out
  if ! out=$(jq "$@" "$CLAUDE_SETTINGS"); then
    warn "couldn't update ${CLAUDE_SETTINGS/#$HOME/~} (invalid JSON?); left it unchanged"
    return 0
  fi
  # Write in place, not mv: keeps the file's permissions and any symlink.
  printf '%s\n' "$out" > "$CLAUDE_SETTINGS"
}

# shellcheck disable=SC2016  # $id, $name and $host are jq variables
claude_add() {
  claude_edit --arg id "limabean-$1" --arg name "$1 (limabean)" --arg host "lima-$1" \
    '.sshConfigs = ([.sshConfigs[]? | select(.id != $id)] + [{id: $id, name: $name, sshHost: $host}])'
}

# shellcheck disable=SC2016  # $id, $name and $host are jq variables
claude_remove() {
  claude_edit --arg id "limabean-$1" \
    'if has("sshConfigs") then .sshConfigs |= map(select(.id != $id)) else . end'
}

# limabean_vms: names of VMs built from these templates (layer-base.yaml
# writes to /etc/limabean/mise/, so their lima.yaml mentions it).
limabean_vms() {
  local name
  limactl list --format '{{.Name}}' 2>/dev/null | while read -r name; do
    if grep '/etc/limabean/mise/' "$HOME/.lima/$name/lima.yaml" >/dev/null 2>&1; then
      echo "$name"
    fi
  done
}

# claude_ready: true when Claude Desktop entries can be read and edited.
claude_ready() {
  [ "$CLAUDE_DESKTOP" = yes ] && command -v jq >/dev/null &&
    { [ ! -s "$CLAUDE_SETTINGS" ] || jq empty "$CLAUDE_SETTINGS" 2>/dev/null; }
}

# claude_has <name>: whether Claude Desktop has an entry for the VM.
claude_has() {
  claude_ready && [ -s "$CLAUDE_SETTINGS" ] &&
    jq -e --arg id "limabean-$1" 'any(.sshConfigs[]?; .id == $id)' "$CLAUDE_SETTINGS" >/dev/null
}

# claude_prune: remove Claude Desktop entries and saved state for VMs that no
# longer exist, e.g. ones deleted with `limactl delete`. Prints what it removed.
claude_prune() {
  local vms id name f
  vms=$(limabean_vms)
  if claude_ready && [ -s "$CLAUDE_SETTINGS" ]; then
    for id in $(jq -r '.sshConfigs[]?.id | select(startswith("limabean-"))' "$CLAUDE_SETTINGS"); do
      name=${id#limabean-}
      if ! printf '%s\n' "$vms" | grep -x "$name" >/dev/null; then
        claude_remove "$name"
        info "Removed $name from Claude Desktop (the VM no longer exists)"
      fi
    done
  fi
  for f in "$STATE"/*.env; do
    [ -f "$f" ] || continue
    name=$(basename "$f" .env)
    printf '%s\n' "$vms" | grep -x "$name" >/dev/null || rm -f "$f"
  done
}

# check_unsaved <name>: list git repos under the VM's code dir with
# uncommitted changes, stashes or commits not on any remote. Fails if any.
check_unsaved() {
  local name=$1 report
  ensure_running "$name"
  # shellcheck disable=SC2016  # expanded inside the VM
  report=$(ssh -o BatchMode=yes "lima-$name" 'bash -s' "$CODE_DIR" <<'EOF'
code=${1/#\~/$HOME}
[ -d "$code" ] || exit 0
find "$code" -maxdepth 6 -type d -name .git -prune 2>/dev/null | while read -r git; do
  repo=${git%/.git}
  problems=()
  [ -n "$(git -C "$repo" status --porcelain 2>/dev/null)" ] && problems+=("uncommitted changes")
  [ -n "$(git -C "$repo" stash list 2>/dev/null)" ] && problems+=("stashes")
  [ -n "$(git -C "$repo" log --branches --not --remotes --oneline 2>/dev/null | head -1)" ] && problems+=("unpushed commits")
  if [ ${#problems[@]} -gt 0 ]; then
    (IFS=,; echo "${repo/#$HOME/\~}: ${problems[*]}") | sed 's/,/, /g'
  fi
done
EOF
  ) || die "couldn't check $name for unsaved work (use --force to skip the check)"
  if [ -n "$report" ]; then
    bad "$name has work that would be lost:"
    printf '%s\n' "$report" | sed 's/^/      /'
    hint "Commit and push it, or pass --force to delete anyway."
    return 1
  fi
}

# --- commands ----------------------------------------------------------------

cmd_doctor() {
  local failed=0 v ssh_config=$HOME/.ssh/config inc first rc gitdir

  echo "${bold}Lima${reset}"
  if ! command -v limactl >/dev/null; then
    bad "limactl not found"; hint "brew install lima"; failed=1
  else
    v=$(limactl --version | awk '{print $3}')
    if [ "${v%%.*}" -ge 2 ] 2>/dev/null; then ok "limactl $v"
    else bad "limactl $v is too old; need 2.0 or newer"; hint "brew upgrade lima"; failed=1; fi
  fi

  echo "${bold}SSH config${reset}"
  inc=$(grep -n -i -E '^[[:space:]]*Include[[:space:]].*\.lima/\*/ssh\.config' "$ssh_config" 2>/dev/null | head -1 | cut -d: -f1 || true)
  first=$(grep -n -i -E '^[[:space:]]*(Host|Match)[[:space:]]' "$ssh_config" 2>/dev/null | head -1 | cut -d: -f1 || true)
  if [ -z "$inc" ]; then
    bad "~/.ssh/config doesn't include Lima's host entries"
    hint "Add this line at the top of ~/.ssh/config (or run: limabean init):" "  Include ~/.lima/*/ssh.config"
    failed=1
  elif [ -n "$first" ] && [ "$first" -lt "$inc" ]; then
    bad "the Include on line $inc sits inside the Host/Match block on line $first, so it doesn't apply to lima-<name>"
    hint "Move it to the top of ~/.ssh/config."
    failed=1
  else
    ok "Include ~/.lima/*/ssh.config (line $inc)"
  fi

  echo "${bold}SSH agent${reset} (lets VMs push with your keys)"
  rc=0; ssh-add -l >/dev/null 2>&1 || rc=$?
  case $rc in
    0) ok "$(ssh-add -l | wc -l | tr -d ' ') key(s) loaded" ;;
    1) bad "the agent has no keys, so git push from a VM will fail"
       hint "ssh-add --apple-use-keychain ~/.ssh/id_ed25519   (or your key)"
       hint "To keep it after a reboot, add to ~/.ssh/config under 'Host *':" "  AddKeysToAgent yes" "  UseKeychain yes"
       failed=1 ;;
    *) bad "no ssh-agent reachable (SSH_AUTH_SOCK=${SSH_AUTH_SOCK:-unset})"; failed=1 ;;
  esac

  echo "${bold}Git config${reset} (GIT_CONFIG_DIR=$GIT_CONFIG_DIR)"
  gitdir=$(expand "$GIT_CONFIG_DIR")
  if [ -f "$gitdir/config" ] || [ -f "$gitdir/.gitconfig" ]; then
    local f
    for f in "$gitdir/config" "$gitdir/.gitconfig"; do
      [ -f "$f" ] && { ok "found ${f/#$HOME/~}"; break; }
    done
  else
    bad "no config or .gitconfig in $GIT_CONFIG_DIR; VMs won't know your git identity"
    hint "Run limabean init, or move ~/.gitconfig to ~/.config/git/config."
    failed=1
  fi

  echo "${bold}Claude Desktop${reset} (each VM as an SSH connection)"
  if [ "$CLAUDE_DESKTOP" != yes ]; then
    ok "off (CLAUDE_DESKTOP in config)"
  elif ! command -v jq >/dev/null; then
    bad "jq not found; it's needed to add VMs to ${CLAUDE_SETTINGS/#$HOME/~}"; hint "brew install jq"; failed=1
  else
    ok "$(jq '[.sshConfigs[]? | select(.id | startswith("limabean-"))] | length' "$CLAUDE_SETTINGS" 2>/dev/null || echo 0) VM(s) registered in ${CLAUDE_SETTINGS/#$HOME/~}"
  fi

  echo "${bold}Config${reset}"
  if [ -f "$CONFIG" ]; then ok "${CONFIG/#$HOME/~}"; else warn "no ${CONFIG/#$HOME/~}; using defaults (run limabean init)"; fi

  echo
  if [ $failed -eq 0 ]; then echo "${green}All good.${reset}"; else echo "${red}Fix the items above.${reset}"; fi
  return $failed
}

cmd_init() {
  local guess git_dir code_dir ssh_config=$HOME/.ssh/config reply

  # Best guess for the git config directory: where ~/.gitconfig really lives.
  if [ -L "$HOME/.gitconfig" ]; then
    guess=$(cd "$HOME" && cd "$(dirname "$(readlink "$HOME/.gitconfig")")" && pwd)
    guess=${guess/#$HOME/\~}
  else
    guess=$GIT_CONFIG_DIR
  fi

  echo "limabean setup. Press enter to accept the [default]."
  read -r -p "Host directory with your git config [$guess]: " git_dir
  git_dir=${git_dir:-$guess}
  read -r -p "Where repositories go inside VMs [$CODE_DIR]: " code_dir
  code_dir=${code_dir:-$CODE_DIR}

  mkdir -p "$(dirname "$CONFIG")"
  cat > "$CONFIG" <<EOF
# limabean config, read by bin/limabean. Applies to VMs created afterwards.

# Host directory with your git config, mounted read-only into VMs.
GIT_CONFIG_DIR="$git_dir"

# Where ghq clones repositories inside VMs.
CODE_DIR="$code_dir"

# VM size; empty uses the template default (4 CPUs, 8 GiB).
CPUS="$CPUS"
MEMORY="$MEMORY"

# Add each VM to Claude Desktop as an SSH connection (~/.claude/settings.json).
CLAUDE_DESKTOP="$CLAUDE_DESKTOP"
EOF
  # Re-read, so the doctor run below sees the new values.
  # shellcheck disable=SC1090
  . "$CONFIG"
  info "Wrote ${CONFIG/#$HOME/~}"

  if ! grep -q -i -E '^[[:space:]]*Include[[:space:]].*\.lima/\*/ssh\.config' "$ssh_config" 2>/dev/null; then
    read -r -p "Add 'Include ~/.lima/*/ssh.config' to the top of ~/.ssh/config? [y/N] " reply
    case $reply in
      [yY]*)
        mkdir -p "$HOME/.ssh" && chmod 700 "$HOME/.ssh"
        [ -f "$ssh_config" ] && cp "$ssh_config" "$ssh_config.limabean.bak"
        { echo "Include ~/.lima/*/ssh.config"; echo; cat "$ssh_config" 2>/dev/null || true; } > "$ssh_config.tmp"
        mv "$ssh_config.tmp" "$ssh_config"
        chmod 600 "$ssh_config"
        info "Updated ~/.ssh/config (backup: ~/.ssh/config.limabean.bak)" ;;
    esac
  fi

  echo
  cmd_doctor || true
}

cmd_new() {
  [ $# -ge 1 ] || die "usage: limabean new <name> [environment]"
  local name=$1 env=${2:-scratch}
  exists "$name" && die "a VM named '$name' already exists"
  claude_prune
  cmd_doctor >/dev/null 2>&1 || warn "limabean doctor reports problems; the VM will still be created"
  create "$name" "$env"
  claude_add "$name"
  echo
  info "Ready. Connect with: ${bold}ssh lima-$name${reset}  (or: limabean ssh $name)"
  if [ "$CLAUDE_DESKTOP" = yes ]; then
    info "In Claude Desktop, pick ${bold}$name (limabean)${reset} under SSH in the environment dropdown."
  fi
}

cmd_ls() {
  local name status cpus mem env found=0
  claude_prune
  printf '%-16s %-10s %-12s %-5s %-7s %s\n' NAME STATUS ENV CPUS MEMORY "SSH HOST"
  while read -r name status cpus mem; do
    limabean_vms | grep -x "$name" >/dev/null || continue
    found=1
    env=$(cat "$STATE/$name.env" 2>/dev/null || echo "-")
    printf '%-16s %-10s %-12s %-5s %-7s %s\n' "$name" "$status" "$env" "$cpus" "$((mem / 1073741824))GiB" "lima-$name"
  done < <(limactl list --format '{{.Name}} {{.Status}} {{.CPUs}} {{.Memory}}' 2>/dev/null)
  [ $found -eq 1 ] || echo "(none yet: limabean new <name>)"
}

cmd_ssh() {
  [ $# -ge 1 ] || die "usage: limabean ssh <name> [command…]"
  local name=$1; shift
  need_vm "$name"
  ensure_running "$name"
  exec ssh "lima-$name" "$@"
}

cmd_get() {
  [ $# -ge 2 ] || die "usage: limabean get <name> [-p] <repo>   (e.g. limabean get dev rossedman/limabean)"
  local name=$1; shift
  need_vm "$name"
  ensure_running "$name"
  # shellcheck disable=SC2029  # the arguments are meant for ghq in the VM
  ssh "lima-$name" ghq get "$@"
}

cmd_stop() {
  [ $# -ge 1 ] || die "usage: limabean stop <name>"
  need_vm "$1"
  limactl stop "$1"
}

# parse_force <args…>: sets FORCE and NAME.
parse_force() {
  FORCE=0 NAME=""
  local a
  for a in "$@"; do
    case $a in
      -f|--force) FORCE=1 ;;
      -*) die "unknown flag $a" ;;
      *) NAME=$a ;;
    esac
  done
  [ -n "$NAME" ] || die "usage: limabean $CMD <name> [--force]"
}

cmd_rm() {
  parse_force "$@"
  if ! exists "$NAME"; then
    # Already deleted (say, with limactl delete): clean up what's left.
    if claude_has "$NAME" || [ -f "$STATE/$NAME.env" ]; then
      claude_remove "$NAME"
      rm -f "$STATE/$NAME.env"
      info "No VM named $NAME; removed what was left of it (Claude Desktop entry, saved state)"
      return 0
    fi
    die "no VM named '$NAME' (see: limabean ls)"
  fi
  [ $FORCE -eq 1 ] || check_unsaved "$NAME" || exit 1
  limactl delete -f "$NAME"
  rm -f "$STATE/$NAME.env"
  claude_remove "$NAME"
  info "Deleted $NAME"
}

cmd_rebuild() {
  parse_force "$@"
  need_vm "$NAME"
  local env
  env=$(cat "$STATE/$NAME.env" 2>/dev/null || echo scratch)
  [ $FORCE -eq 1 ] || check_unsaved "$NAME" || exit 1
  info "Rebuilding $NAME from the current $env template"
  limactl delete -f "$NAME"
  create "$NAME" "$env"
  info "Rebuilt. Repositories were not kept; clone them again with: limabean get $NAME <repo>"
}

cmd_claude() {
  [ "${1:-}" = sync ] || die "usage: limabean claude sync"
  [ "$CLAUDE_DESKTOP" = yes ] || die "CLAUDE_DESKTOP is off in ${CONFIG/#$HOME/~}"
  command -v jq >/dev/null || die "jq is required: brew install jq"
  if [ -s "$CLAUDE_SETTINGS" ] && ! jq empty "$CLAUDE_SETTINGS" 2>/dev/null; then
    die "${CLAUDE_SETTINGS/#$HOME/~} isn't valid JSON; fix it, then run this again"
  fi
  local vms id
  vms=$(limabean_vms)
  claude_prune
  for id in $vms; do
    claude_add "$id"
    info "Registered ${bold}$id (limabean)${reset} → ssh lima-$id"
  done
  [ -n "$vms" ] || info "No limabean VMs to register."
}

cmd_help() {
  cat <<EOF
limabean: disposable Linux dev VMs on macOS, built from Lima templates.

Usage: limabean <command> [args]

Setup
  init                       save your settings and fix ~/.ssh/config
  doctor                     check that everything VMs depend on is in place

VMs
  new <name> [env]           create a VM (env: $(envs | tr '\n' ' ' | sed 's/ $//'); default scratch)
  ls                         list VMs
  ssh <name> [command…]      open a shell, or run a command (starts the VM if needed)
  get <name> [-p] <repo>     clone a repository into the VM with ghq (-p: over SSH)
  stop <name>                stop a VM
  rebuild <name> [--force]   recreate from the current templates
  rm <name> [--force]        delete a VM

Claude Desktop
  claude sync                add every VM as an SSH connection and remove
                             deleted ones (new, rm and ls already do this)

rm and rebuild refuse to run while repositories in the VM have uncommitted,
stashed or unpushed work; --force skips that check.

Config: ${CONFIG/#$HOME/~}
EOF
}

CMD=${1:-help}
[ $# -gt 0 ] && shift
case $CMD in
  init) cmd_init "$@" ;;
  doctor) cmd_doctor "$@" ;;
  new|create) cmd_new "$@" ;;
  ls|list) cmd_ls "$@" ;;
  ssh|shell) cmd_ssh "$@" ;;
  get|clone) cmd_get "$@" ;;
  stop) cmd_stop "$@" ;;
  rm|delete) cmd_rm "$@" ;;
  rebuild) cmd_rebuild "$@" ;;
  claude) cmd_claude "$@" ;;
  help|-h|--help) cmd_help ;;
  *) die "unknown command '$CMD' (see: limabean help)" ;;
esac
