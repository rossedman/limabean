# Interactive zsh. Written by layer-base.yaml on every boot; edit
# templates/files/zshrc, or put personal additions in ~/.zshrc.local.

# history
HISTFILE=~/.zsh_history
HISTSIZE=50000
SAVEHIST=50000
setopt share_history hist_ignore_all_dups hist_ignore_space hist_reduce_blanks
setopt auto_cd interactive_comments no_beep

# keys and completion
bindkey -e
fpath=(~/.local/share/zsh/completions $fpath)   # generated by features/completions.sh
autoload -Uz compinit && compinit
compdef docker=nerdctl                          # docker is nerdctl here
autoload -Uz bashcompinit && bashcompinit       # tools with bash-style completion
complete -C aws_completer aws
complete -o nospace -C terraform terraform
complete -C gocomplete go
zstyle ':completion:*' menu select
zstyle ':completion:*' matcher-list 'm:{a-z}={A-Z}'
zstyle ':completion:*' list-colors "${(s.:.)LS_COLORS}"

# aliases
alias ls='ls --color=auto'
alias ll='ls -lAh --color=auto'
alias grep='grep --color=auto'

# jump to a ghq repository with fzf
repo() {
  local dir
  dir=$(ghq list -p | fzf --height 40% --reverse --query "$*") && cd "$dir"
}

# tool hooks
source <(fzf --zsh)                 # ctrl-r history, ctrl-t files, alt-c dirs
eval "$(direnv hook zsh)"

# prompt:  scratch:~/c/g/r/limabean (main*) ❯
# VM name, path with parent dirs shortened to one letter, git branch with
# * for unstaged, + for staged and ? for untracked changes, and ❯ in red after a failed command.
autoload -Uz vcs_info add-zsh-hook
zstyle ':vcs_info:*' enable git
zstyle ':vcs_info:*' check-for-changes true
zstyle ':vcs_info:*' unstagedstr '*'
zstyle ':vcs_info:*' stagedstr '+'
zstyle ':vcs_info:git:*' formats ' (%b%u%c)'
zstyle ':vcs_info:git:*' actionformats ' (%b|%a%u%c)'
zstyle ':vcs_info:git*+set-message:*' hooks git-untracked
+vi-git-untracked() {   # vcs_info ignores untracked files; mark them with ?
  [[ -n $(git ls-files --others --exclude-standard --directory --no-empty-directory 2>/dev/null | head -1) ]] &&
    hook_com[unstaged]+='?'
}
add-zsh-hook precmd vcs_info

_short_pwd() {
  local p=${PWD/#$HOME/\~}
  [[ $p == / ]] && { print /; return }
  local -a parts=("${(@s:/:)p}")
  local out= i
  for (( i = 1; i < $#parts; i++ )); do
    [[ ${parts[i]} == .* ]] && out+="${parts[i][1,2]}/" || out+="${parts[i][1]}/"
  done
  print -r -- "$out${parts[-1]}"
}

setopt prompt_subst
PROMPT='%B%F{green}${HOST#lima-}%f:%F{cyan}$(_short_pwd)%f%F{magenta}${vcs_info_msg_0_}%f%b %(?.%F{green}.%F{red})❯%f '

[ -f ~/.zshrc.local ] && source ~/.zshrc.local

# plugins; syntax highlighting must be sourced last
source /usr/share/zsh-autosuggestions/zsh-autosuggestions.zsh
source /usr/share/zsh-syntax-highlighting/zsh-syntax-highlighting.zsh
